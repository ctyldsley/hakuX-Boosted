[submodule "external/fex"]
	path = external/fex
	url = https://github.com/rfandango/FEX.git
	branch = hakuX

# The Xbox 360 side (x360/, XenDroid): its submodules, as x360/.gitmodules
# lists them, under x360/. Regenerate with boosted/tools/sync-x360-gitmodules.py
# after a subtree pull.
