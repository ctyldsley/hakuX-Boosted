// hakuX-Boosted bench: generated by core/CMakeLists.txt, and found before
// the core's own xenia/base/host_thread_state.h on the include path.
//
// That header compiles the host_thread_state_slot code (the current guest
// thread, CPU thread and so on read with "mrs tpidr_el0; ldr [..., #16]"
// instead of through thread-local variables) only when __ANDROID__ is
// defined, because the slot at the thread pointer plus 16 is bionic's
// TLS_SLOT_APP. On AArch64 glibc the same address is the first word of the
// executable's own thread-local block, and the bench launcher owns that word
// (core/launcher.c). So the header is read here as an Android build reads
// it, and nothing else is: platform.h and the standard headers it needs are
// included first, without the macro.
#ifndef BOOSTED_BENCH_SHADOW_HOST_THREAD_STATE_H_
#define BOOSTED_BENCH_SHADOW_HOST_THREAD_STATE_H_
#include <atomic>
#include <cstdint>

#include "xenia/base/platform.h"

#ifndef __ANDROID__
#define __ANDROID__ 1
#define BOOSTED_BENCH_UNDEF_ANDROID 1
#endif
#include "@XE_SRC@/base/host_thread_state.h"
#ifdef BOOSTED_BENCH_UNDEF_ANDROID
#undef __ANDROID__
#undef BOOSTED_BENCH_UNDEF_ANDROID
#endif
#endif  // BOOSTED_BENCH_SHADOW_HOST_THREAD_STATE_H_
